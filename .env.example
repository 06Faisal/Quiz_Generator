GEMINI_API_KEY=your_api_key_here

# Optional. When set, the whole app asks for this password over HTTP Basic auth.
# Leave it unset for local use. Set it on any deployment with a public URL, so
# strangers cannot spend your Gemini quota.
APP_PASSWORD=

# Optional. Set to 1 to run the Flask debugger. Never set this on a deployment:
# the debugger allows arbitrary code execution.
FLASK_DEBUG=0
